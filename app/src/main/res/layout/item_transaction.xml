<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="10dp"
    android:paddingHorizontal="12dp"
    android:background="#E8DCC8"
    android:layout_marginVertical="4dp">

    <!-- ========================================= -->
    <!-- TRANSACTION ICON -->
    <!-- ========================================= -->

    <ImageView
        android:id="@+id/ivTxIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:padding="7dp"
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_menu_agenda"
        android:contentDescription="Transaction icon" />

    <!-- ========================================= -->
    <!-- TRANSACTION DETAILS -->
    <!-- ========================================= -->

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/ivTxIcon"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTxTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zepto Grocery"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTxSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Food &amp; Drinks • Today"
            android:textColor="#8A8A93"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- ========================================= -->
    <!-- TRANSACTION AMOUNT -->
    <!-- ========================================= -->

    <TextView
        android:id="@+id/tvTxAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:text="-₹450.00"
        android:textColor="#FF5252"
        android:textSize="14sp"
        android:textStyle="bold" />

</RelativeLayout>