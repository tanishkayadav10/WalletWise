<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/jdf">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Budget Setup &amp; Expenses"
            android:textColor="#1A237E"
            android:textSize="22sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTotalBudget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Total Budget (₹)"
            android:inputType="numberDecimal"
            android:textColorHint="#000000"/>



        <EditText
            android:id="@+id/etHouseRent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="House Rent (₹)"
            android:inputType="numberDecimal"
            android:textColorHint="#000000"/>



        <EditText
            android:id="@+id/etGroceries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Groceries (₹)"
            android:inputType="numberDecimal"
            android:textColorHint="#000000"/>

        <EditText
            android:id="@+id/etFuel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Fuel / Transport (₹)"
            android:inputType="numberDecimal"
            android:textColorHint="#000000"/>

        <EditText
            android:id="@+id/etPersonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Personal Care / Hygiene (₹)"
            android:inputType="numberDecimal"
            android:textColorHint="#000000"/>

        <EditText
            android:id="@+id/etSubscriptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Subscriptions / Bills (₹)"
            android:inputType="numberDecimal"
            android:textColorHint="#000000"/>

        <!-- CUSTOM CATEGORY -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Add Your Own Category"
            android:textColor="#1A237E"
            android:textSize="18dp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCustomCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Category name e.g. Shopping"
            android:inputType="textCapSentences"
            android:textColorHint="#000000"/>



        <EditText
            android:id="@+id/etCustomAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Amount (₹)"
            android:inputType="numberDecimal"
            android:textColorHint="#000000"/>

        <!-- SAVE -->

        <Button
            android:id="@+id/btnSaveContinue"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#673AB7"
            android:text="Save &amp; Continue"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:cornerRadius="26dp" />

    </LinearLayout>

</ScrollView>